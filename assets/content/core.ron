// Contenu de base du monde (§3.1). Chargé au démarrage par le binaire.
//
// L'ORDRE FIXE LES IDs : ajouter à la fin, ne jamais réordonner ni
// supprimer une entrée — les chunks référencent les IDs.
//
// `texture` : PNG de `assets/textures/` (sans `.png`), 1 image = 1 m. `side`
// sert aussi au dessus et au dessous s'ils ne sont pas précisés. Sans
// texture, le bloc est rendu de sa `color` ; `color` sert aussi aux items.
[
    (identifier: "core:air",   kind: Block((solid: false, color: (0.0, 0.0, 0.0)))),
    // `drops` : ce que donne le bloc cassé. Absent = lui-même, Some([]) = rien.
    (identifier: "core:grass", kind: Block((solid: true,  color: (0.35, 0.6, 0.25), drops: Some(["core:dirt"]),
        texture: Some((side: "grass_side", top: Some("grass_top"), bottom: Some("dirt"))),
        // Une fois sur cinq, une graine de blé en plus de la terre (#34).
        rules: [(on: Broken, when: [Chance(0.2)], then: [Drop("core:wheat_seeds")])]))),
    (identifier: "core:stone", kind: Block((solid: true,  color: (0.55, 0.55, 0.58), texture: Some((side: "stone"))))),
    // À l'air libre, la terre redevient de l'herbe (#34, tick aléatoire :
    // deux minutes en moyenne, ici et là).
    (identifier: "core:dirt",  kind: Block((solid: true,  color: (0.45, 0.30, 0.15), texture: Some((side: "dirt")),
        rules: [(on: Tick, when: [Above("core:air"), Chance(0.5)], then: [ReplaceSelf("core:grass")])]))),
    (identifier: "core:sand",  kind: Block((solid: true,  color: (0.85, 0.78, 0.55), texture: Some((side: "sand")))),
        recipes: [(inputs: ["core:stone", "core:stone"], count: 2, station: "core:workbench")]),

    // Lampe : un clic droit bascule entre éteinte et allumée (§3.6, règles).
    // Aucun code Rust ne la connaît. Allumée, elle éclaire à 14 m
    // (`emits_light`, #23) et se casse en lampe éteinte.
    (identifier: "core:lamp", kind: Block((solid: true, color: (0.30, 0.27, 0.12),
        texture: Some((side: "lamp")),
        rules: [(on: Used, then: [ReplaceSelf("core:lamp_lit")])])),
        recipes: [(inputs: ["core:stone", "core:stone", "core:stone", "core:dirt"], station: "core:workbench")]),
    (identifier: "core:lamp_lit", kind: Block((solid: true, color: (1.0, 0.85, 0.35),
        texture: Some((side: "lamp_lit")),
        emits_light: Some(14.0),
        drops: Some(["core:lamp"]),
        rules: [(on: Used, then: [ReplaceSelf("core:lamp")])]))),

    // Établi (jalon 3) : garde jusqu'à 9 items posés dessus (block-entity,
    // §3.3). Clic droit item en main : le pose dessus ; main vide : fabrique
    // si le contenu est une recette faite ici, sinon rend les items. Les
    // recettes sont portées par l'entrée produite (`recipes`, ci-dessus).
    // Sa propre recette est sans `station` : elle se fait depuis
    // l'inventaire (menu de fabrication, touche C).
    (identifier: "core:workbench", kind: Block((solid: true, color: (0.55, 0.36, 0.18),
        texture: Some((side: "planks", top: Some("workbench_top"))),
        storage: Some(9),
        rules: [
            (on: Used, when: [HoldingAny], then: [StoreHeld]),
            (on: Used, when: [EmptyHand], then: [Craft]),
        ])),
        recipes: [(inputs: ["core:dirt", "core:dirt", "core:stone", "core:stone"])]),

    // Worldgen (#27) : posés par `worldgen.ron`. Textures calculées par le
    // moteur (`generated_textures`, #44) : motif, couleur, bruit, graine.
    // Une bûche posée se couche contre la face visée (#14) ; le worldgen
    // la pose debout.
    (identifier: "core:log", kind: Block((solid: true, color: (0.40, 0.28, 0.15), orient: Face,
        texture: Some((side: "log_side", top: Some("log_top"), bottom: Some("log_top"))),
        generated_textures: [
            (name: "log_side", pattern: Cracks, color: (0.40, 0.28, 0.15), noise: 0.25, seed: 1),
            (name: "log_top", pattern: Frame, color: (0.62, 0.48, 0.30), noise: 0.15, seed: 2),
        ]))),
    // `alpha: Mask` + `holes` : on voit à travers le feuillage (#22).
    (identifier: "core:leaves", kind: Block((solid: true, color: (0.22, 0.45, 0.16), alpha: Mask,
        texture: Some((side: "leaves")),
        generated_textures: [(name: "leaves", pattern: Spots, color: (0.22, 0.45, 0.16), noise: 0.35, seed: 3, holes: 0.3)],
        drops: Some([])))),
    (identifier: "core:planks", kind: Block((solid: true, color: (0.62, 0.45, 0.25),
        texture: Some((side: "planks")))),
        recipes: [(inputs: ["core:log"], count: 4)]),

    // Formes (#14) : boîtes en seizièmes de case, (coin bas), (coin haut).
    // Un modèle se dessine pour un joueur qui regarde vers +Z ; `orient`
    // dit comment il se tourne à la pose.
    // Dalle : à l'envers posée contre le haut d'une face ou sous un bloc.
    (identifier: "core:planks_slab", kind: Block((solid: true, color: (0.62, 0.45, 0.25),
        texture: Some((side: "planks")),
        shape: Some([((0, 0, 0), (16, 8, 16))]), orient: Half)),
        recipes: [(inputs: ["core:planks", "core:planks", "core:planks"], count: 6)]),
    // Escalier : la marche haute au fond (+Z), tourné selon le regard.
    (identifier: "core:planks_stairs", kind: Block((solid: true, color: (0.62, 0.45, 0.25),
        texture: Some((side: "planks")),
        shape: Some([((0, 0, 0), (16, 8, 16)), ((0, 8, 8), (16, 16, 16))]), orient: Facing)),
        recipes: [(inputs: ["core:planks", "core:planks", "core:planks", "core:planks"], count: 4)]),
    // Torche : on la traverse (`collision: []`), elle se pose sur toutes
    // les faces (couchée contre un mur), éclaire à 10 m.
    (identifier: "core:torch", kind: Block((solid: true, color: (1.0, 0.80, 0.35), emits_light: Some(10.0),
        texture: Some((side: "torch")),
        generated_textures: [(name: "torch", pattern: Plain, color: (1.0, 0.80, 0.35), noise: 0.15, seed: 14)],
        shape: Some([((7, 0, 7), (9, 10, 9))]), collision: Some([]), orient: Face)),
        recipes: [(inputs: ["core:planks", "core:coal_ore"], count: 4)]),
    (identifier: "core:cactus", kind: Block((solid: true, color: (0.30, 0.55, 0.25),
        texture: Some((side: "cactus_side", top: Some("cactus_top"))),
        generated_textures: [
            (name: "cactus_side", pattern: Planks, color: (0.30, 0.55, 0.25), noise: 0.2, seed: 4),
            (name: "cactus_top", pattern: Frame, color: (0.38, 0.62, 0.30), noise: 0.15, seed: 5),
        ]))),
    (identifier: "core:coal_ore", kind: Block((solid: true, color: (0.30, 0.30, 0.32),
        texture: Some((side: "coal_ore")),
        generated_textures: [(name: "coal_ore", pattern: Spots, color: (0.35, 0.35, 0.37), noise: 0.3, seed: 6)]))),
    (identifier: "core:iron_ore", kind: Block((solid: true, color: (0.62, 0.50, 0.42),
        texture: Some((side: "iron_ore")),
        generated_textures: [(name: "iron_ore", pattern: Spots, color: (0.62, 0.50, 0.42), noise: 0.3, seed: 7)]))),
    // Verre : `Frame` percé partout, seul le cadre reste. Se casse en rien.
    (identifier: "core:glass", kind: Block((solid: true, color: (0.75, 0.88, 0.92), alpha: Mask,
        texture: Some((side: "glass")),
        generated_textures: [(name: "glass", pattern: Frame, color: (0.75, 0.88, 0.92), noise: 0.1, seed: 8, holes: 1.0)],
        drops: Some([]))),
        recipes: [(inputs: ["core:sand", "core:sand"], count: 1)]),

    // Blé (#34) : graine → pousse → blé mûr, une minute par stade
    // (minuteur : exact, et ça pousse aussi en l'absence du joueur). Mûr, il
    // se casse en blé + deux graines.
    (identifier: "core:wheat_seeds", kind: Block((solid: true, color: (0.55, 0.45, 0.25), alpha: Mask,
        texture: Some((side: "wheat_seeds")),
        generated_textures: [(name: "wheat_seeds", pattern: Spots, color: (0.55, 0.45, 0.25), noise: 0.3, seed: 9, holes: 0.85)],
        rules: [(on: After(60.0), then: [ReplaceSelf("core:wheat_sprout")])],
        drops: Some(["core:wheat_seeds"])))),
    (identifier: "core:wheat_sprout", kind: Block((solid: true, color: (0.35, 0.65, 0.25), alpha: Mask,
        texture: Some((side: "wheat_sprout")),
        generated_textures: [(name: "wheat_sprout", pattern: Planks, color: (0.35, 0.65, 0.25), noise: 0.3, seed: 10, holes: 0.6)],
        rules: [(on: After(60.0), then: [ReplaceSelf("core:wheat")])],
        drops: Some(["core:wheat_seeds"])))),
    (identifier: "core:wheat", kind: Block((solid: true, color: (0.85, 0.72, 0.30), alpha: Mask,
        texture: Some((side: "wheat")),
        generated_textures: [(name: "wheat", pattern: Planks, color: (0.85, 0.72, 0.30), noise: 0.3, seed: 11, holes: 0.4)],
        drops: Some(["core:wheat", "core:wheat_seeds", "core:wheat_seeds"])))),

    // Liquides (#28) : `liquid` règle l'écoulement — distance à plat en
    // mètres, temps d'un pas en secondes, deux sources voisines en font une
    // troisième (`renewable`), freinage du joueur (`drag`). Posés depuis
    // l'inventaire (touche G), on ne les casse pas.
    // Eau : semi-transparente (`Blend`, opacité 0.6), rapide. Sous elle, la
    // lumière du ciel porte moins loin (`light_loss`, #23) : on voit le fond
    // jusqu'à ~10 m.
    (identifier: "core:water", kind: Block((solid: false, color: (0.20, 0.40, 0.85), alpha: Blend(0.6), light_loss: 0.5,
        texture: Some((side: "water")),
        generated_textures: [(name: "water", pattern: Plain, color: (0.20, 0.40, 0.85), noise: 0.1, seed: 12)],
        liquid: Some((spread: 7.0, delay: 0.25, renewable: true, drag: 0.5))))),
    // Lave : opaque, lente, épaisse, ne se renouvelle pas, éclaire à 15 m.
    // Au contact de l'eau, elle devient pierre — une règle, aucun code Rust.
    (identifier: "core:lava", kind: Block((solid: false, color: (0.95, 0.40, 0.05), emits_light: Some(15.0),
        texture: Some((side: "lava")),
        generated_textures: [(name: "lava", pattern: Spots, color: (0.95, 0.40, 0.05), noise: 0.35, seed: 13)],
        liquid: Some((spread: 3.0, delay: 1.5, drag: 0.8)),
        rules: [(on: NeighborChanged, when: [Touching("core:water")], then: [ReplaceSelf("core:stone")])]))),

    // Entités (#15) : un modèle en parties, boîtes en seizièmes de mètre,
    // dessiné pieds en y = 0 et regardant vers +Z ; chaque partie tourne
    // autour de son pivot (animation : #32). `size` : la collision, en
    // mètres. Posé depuis l'inventaire (touche G), il ne bouge pas encore.
    (identifier: "core:pig", kind: EntityType((size: (0.9, 0.9),
        model: [
            (name: "body", pivot: (0, 10, 0), boxes: [((-5, 6, -8), (5, 14, 8), "pig_skin")]),
            (name: "head", parent: "body", pivot: (0, 11, 8), boxes: [
                ((-4, 8, 8), (4, 16, 14), "pig_skin"),
                ((-2, 9, 14), (2, 12, 15), "pig_snout"),
                ((-3, 13, 14), (-2, 14, 15), "pig_eye"),
                ((2, 13, 14), (3, 14, 15), "pig_eye"),
            ]),
            (name: "leg_front_left", parent: "body", pivot: (3, 6, 5), boxes: [((1, 0, 3), (5, 6, 7), "pig_skin")]),
            (name: "leg_front_right", parent: "body", pivot: (-3, 6, 5), boxes: [((-5, 0, 3), (-1, 6, 7), "pig_skin")]),
            (name: "leg_back_left", parent: "body", pivot: (3, 6, -5), boxes: [((1, 0, -7), (5, 6, -3), "pig_skin")]),
            (name: "leg_back_right", parent: "body", pivot: (-3, 6, -5), boxes: [((-5, 0, -7), (-1, 6, -3), "pig_skin")]),
        ],
        behaviors: [
            // `keep` : un cochon apparu seul qui a suivi le blé 10 s en tout
            // reste (élevage) ; le croiser blé en main ne suffit pas.
            Follow(holding: "core:wheat", range: 10.0, speed: 1.6, keep: Some(10.0)),
            LookAt(range: 6.0, time: 3.0),
            Wander(speed: 1.0, range: 8.0, pause: 6.0),
        ],
        // Apparition (#60) : sur l'herbe, en plein jour, ~3 au plus dans
        // 64 m autour d'un point (π × 64² × 0,0003), par 2 ou 3 ; disparaît
        // au-delà de 128 m.
        spawn: [(on: ["core:grass"], light: (0.5, 1.0), density: 0.0003, group: (2, 3), despawn: 128.0)],
        animation: [
            Swing(part: "leg_front_left", angle: 35.0, stride: 1.2, phase: 0.0),
            Swing(part: "leg_back_right", angle: 35.0, stride: 1.2, phase: 0.0),
            Swing(part: "leg_front_right", angle: 35.0, stride: 1.2, phase: 0.5),
            Swing(part: "leg_back_left", angle: 35.0, stride: 1.2, phase: 0.5),
            Look(part: "head", max: 40.0),
        ],
        generated_textures: [
            (name: "pig_skin", pattern: Spots, color: (0.93, 0.66, 0.64), noise: 0.15, seed: 15),
            (name: "pig_snout", pattern: Plain, color: (0.85, 0.50, 0.55), noise: 0.1, seed: 16),
            (name: "pig_eye", pattern: Plain, color: (0.08, 0.08, 0.08), seed: 17),
        ]))),
]
